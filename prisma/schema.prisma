// ==============================================================================
//  โครงสร้างฐานข้อมูลระบบศรีชัยพรอพเพอร์ตี้ (Srichai Property Database Schema)
//  ไฟล์: /prisma/schema.prisma
// ==============================================================================
// วัตถุประสงค์หลัก:
// 1. กำหนดสกีมาตารางฐานข้อมูลทั้งหมดในระบบด้วย Prisma ORM เชื่อมต่อกับ PostgreSQL
// 2. แบ่งการทำงานออกเป็น 8 มอดูลหลัก (Users, Properties, Locations, Appointments,
//    Chat System, Payments & Sales, Reports & Ads, System Configs)
// ==============================================================================

// ------------------------------------------------------------------------------
// การตั้งค่าหลักของ Prisma (Prisma Configuration)
// ------------------------------------------------------------------------------

// ตัวสร้าง Prisma Client สำหรับนำไปใช้เขียนโค้ดภาษา TypeScript/JavaScript ควบคุม DB
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

// แหล่งข้อมูลฐานข้อมูล (เชื่อมต่อกับ PostgreSQL ผ่าน DATABASE_URL ใน .env)
datasource db {
  provider = "postgresql"
}

// ==============================================================================
// 1. ระบบผู้ใช้งานและสิทธิ์ (Users & Auth Module)
// ==============================================================================

/// ตารางบทบาท/สิทธิ์การใช้งานระบบ (เช่น admin, agent, customer)
model roles {
  id         String   @id @db.VarChar(10) // รหัสสิทธิ์ เช่น "admin", "agent", "customer"
  name       String   @unique @db.VarChar(50) // ชื่อสิทธิ์ใช้งาน
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6) // วันเวลาที่สร้างสิทธิ์
  users      users[]
}

/// ตารางผู้ใช้งานระบบหลัก (รองรับทั้ง ลูกค้าทั่วไป, นายหน้าฝากขาย, และแอดมินผู้ดูแลระบบ)
model users {
  id                                                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสผู้ใช้ประจำตัว (UUID)
  email                                               String                  @unique @db.VarChar(100) // อีเมลสำหรับเข้าสู่ระบบ (ห้ามซ้ำกัน)
  password_hash                                       String                  @db.VarChar(255) // รหัสผ่านที่ผ่านการเข้ารหัสด้วย bcrypt
  first_name                                          String                  @db.VarChar(100) // ชื่อจริง
  last_name                                           String                  @db.VarChar(100) // นามสกุล
  phone                                               String?                 @db.VarChar(15) // เบอร์โทรศัพท์ติดต่อ
  profile_image                                       String?                 @db.VarChar(255) // URL รูปภาพโปรไฟล์
  role_id                                             String?                 @db.VarChar(10) // รหัสสิทธิ์ใช้งาน (เชื่อมกับตาราง roles)
  status                                              String?                 @default("pending") @db.VarChar(20) // สถานะบัญชี (เช่น approved, pending, banned)
  is_verified                                         Boolean?                @default(false) // สถานะยืนยันตัวตนแล้วหรือยัง
  plan_type                                           String?                 @default("basic") @db.VarChar(20) // แพ็กเกจใช้งานปัจจุบัน (basic / pro)
  plan_expired_at                                     DateTime?               @db.Timestamptz(6) // วันหมดอายุแพ็กเกจ Pro
  created_at                                          DateTime                @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6) // วันเวลาที่สมัครสมาชิก
  
  // ข้อมูลเพิ่มเติมเฉพาะสำหรับ นายหน้า (Agent Options)
  line_id                                             String?                 @db.VarChar(50) // LINE ID สำหรับให้ลูกค้าติดต่อ
  experience                                          String?                 @db.VarChar(50) // ประสบการณ์การทำงานนายหน้า
  specialty_zone                                      String?                 @db.VarChar(150) // ทำเลที่เชี่ยวชาญเป็นพิเศษ
  specialty_type                                      String?                 @db.VarChar(50) // ประเภทอสังหาฯ ที่เชี่ยวชาญเป็นพิเศษ
  kyc_doc                                             String?                 @db.VarChar(255) // URL เอกสารยืนยันตัวตน (บัตรประชาชน/ใบอนุญาต)

  // ความสัมพันธ์กับตารางอื่นๆ (Relations)
  roles                                               roles?                  @relation(fields: [role_id], references: [id], onUpdate: NoAction)
  agent_availabilities                                agent_availabilities[]
  appointments_appointments_agent_idTousers           appointments[]          @relation("appointments_agent_idTousers")
  appointments_appointments_customer_idTousers        appointments[]          @relation("appointments_customer_idTousers")
  chat_sessions_chat_sessions_agent_idTousers         chat_sessions[]         @relation("chat_sessions_agent_idTousers")
  chat_sessions_chat_sessions_customer_idTousers      chat_sessions[]         @relation("chat_sessions_customer_idTousers")
  login_histories                                     login_histories[]
  messages                                            messages[]
  notifications                                       notifications[]
  properties                                          properties[]
  quick_reply_templates                               quick_reply_templates[]
  reports_reports_reported_agent_idTousers            reports[]               @relation("reports_reported_agent_idTousers")
  reports_reports_reporter_idTousers                  reports[]               @relation("reports_reporter_idTousers")
  sale_transactions_sale_transactions_agent_idTousers sale_transactions[]     @relation("sale_transactions_agent_idTousers")
  sale_transactions_sale_transactions_buyer_idTousers sale_transactions[]     @relation("sale_transactions_buyer_idTousers")
  saved_properties                                    saved_properties[]
}

/// ตารางเก็บวันเวลาที่นายหน้า (Agent) สะดวกรับนัดหมายพาลูกค้าชมบ้าน
model agent_availabilities {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสรายการวันว่าง
  agent_id       String?  @db.Uuid // รหัสนายหน้าผู้กำหนดวันว่าง
  available_date DateTime @db.Date // วันที่สะดวกรับคิวนัด
  time_slot      String?  @db.VarChar(20) // ช่วงเวลาที่สะดวก (เช่น "09:00-10:00")
  is_booked      Boolean? @default(false) // ถูกลูกค้าจองคิวไปแล้วหรือยัง (true/false)
  created_at     DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users          users?   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agent_id, available_date, time_slot])
}

/// ตารางประวัติการเข้าสู่ระบบของผู้ใช้งาน (Login Audit Logs)
model login_histories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสประวัติการล็อกอิน
  user_id    String?  @db.Uuid // รหัสผู้ใช้งานที่ล็อกอิน
  ip_address String?  @db.VarChar(45) // IP Address ขณะเข้าสู่ระบบ
  user_agent String?  // ข้อมูลเบราว์เซอร์และอุปกรณ์ที่ใช้ล็อกอิน
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6) // วันเวลาที่ล็อกอิน
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}


// ==============================================================================
// 2. ระบบอสังหาริมทรัพย์ (Properties Module)
// ==============================================================================

/// ตารางหมวดหมู่ประเภทอสังหาริมทรัพย์ (บ้านเดี่ยว, คอนโด, ทาวน์โฮม, ที่ดิน ฯลฯ)
model property_types {
  id         Int          @id @default(autoincrement()) // รหัสประเภท
  name       String       @unique @db.VarChar(50) // ชื่อประเภทอสังหาริมทรัพย์
  created_at DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  properties properties[]
}

/// ตารางหลักสำหรับเก็บข้อมูลประกาศอสังหาริมทรัพย์ (บ้าน/คอนโด/ที่ดิน)
model properties {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสประกาศอสังหาฯ (UUID)
  title                  String                   @db.VarChar(150) // หัวข้อ/ชื่อประกาศขายหรือเช่า
  price                  Decimal                  @db.Decimal(12, 2) // ราคาขายหรือเช่า (บาท)
  listing_type           String                   @default("sale") @db.VarChar(10) // ประเภทประกาศ: sale (ขาย) หรือ rent (เช่า)
  type_id                Int?                     // ประเภทอสังหาฯ (เชื่อมกับตาราง property_types)
  location               String                   // ข้อความที่อยู่ทำเลที่ตั้ง
  latitude               Decimal?                 @db.Decimal(10, 8) // พิกัดแผนที่ ละติจูด
  longitude              Decimal?                 @db.Decimal(11, 8) // พิกัดแผนที่ ลองจิจูด
  description            String?                  // ข้อความรายละเอียดอสังหาริมทรัพย์
  bedrooms               Int?                     @default(0) // จำนวนห้องนอน
  bathrooms              Int?                     @default(0) // จำนวนห้องน้ำ
  area_sqm               Decimal?                 @db.Decimal(8, 2) // ขนาดพื้นที่ (ตารางเมตร)
  status                 String?                  @default("pending") @db.VarChar(20) // สถานะประกาศ (approved, pending, rejected, sold)
  reject_reason          String?                  @db.VarChar(255) // เหตุผลที่แอดมินไม่อนุมัติประกาศ (กรณีถูกตีกลับ)
  views_count            Int                      @default(0) // จำนวนครั้งที่มีคนเปิดดูหน้ารายละเอียดประกาศนี้
  agent_id               String?                  @db.Uuid // รหัสนายหน้าผู้ดูแลประกาศนี้
  province_id            Int?                     // รหัสจังหวัด
  amphure_id             Int?                     // รหัสอำเภอ/เขต
  district_id            Int?                     // รหัสตำบล/แขวง
  created_at             DateTime                 @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  // ความสัมพันธ์กับตารางอื่นๆ (Relations)
  appointments           appointments[]
  chat_sessions          chat_sessions[]
  listing_package_orders listing_package_orders[]
  users                  users?                   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  property_types         property_types?          @relation(fields: [type_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  provinces              provinces?               @relation(fields: [province_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  amphures               amphures?                @relation(fields: [amphure_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  districts              districts?               @relation(fields: [district_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  property_amenities     property_amenities[]
  property_documents     property_documents[]
  property_images        property_images[]
  property_nearbies      property_nearbies[]
  reports                reports[]
  sale_transactions      sale_transactions[]
  saved_properties       saved_properties[]
  property_viewing_slots property_viewing_slots[]

  // การสร้าง Index เพื่อเร่งความเร็วในการค้นหา (Search Optimization)
  @@index([agent_id], map: "idx_properties_agent")
  @@index([status], map: "idx_properties_status")
  @@index([listing_type], map: "idx_properties_listing_type")
  @@index([province_id], map: "idx_properties_province")
  @@index([amphure_id], map: "idx_properties_amphure")
  @@index([district_id], map: "idx_properties_district")
}

/// ตารางอัลบั้มรูปภาพประกอบของอสังหาริมทรัพย์
model property_images {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสรูปภาพ
  property_id String?     @db.Uuid // รหัสอสังหาริมทรัพย์เจ้าของรูป
  image_url   String      @db.VarChar(255) // URL หรือลิงก์ไฟล์รูปภาพ
  order_index Int?        @default(0) // ลำดับการเรียงรูปภาพ
  created_at  DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  properties  properties? @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// ตารางไฟล์เอกสารแนบของอสังหาริมทรัพย์ (เช่น โฉนดที่ดิน, สัญญาฝากขาย)
model property_documents {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id String?     @db.Uuid
  doc_url     String      @db.VarChar(255) // URL ไฟล์เอกสาร
  doc_type    String?     @db.VarChar(50) // ประเภทเอกสาร (เช่น "deed" โฉนด)
  status      String?     @default("pending") @db.VarChar(20) // สถานะการตรวจสอบเอกสาร
  created_at  DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  properties  properties? @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// ตารางมาสเตอร์รายการสิ่งอำนวยความสะดวก (สระว่ายน้ำ, ฟิตเนส, รปภ. 24 ชม. ฯลฯ)
model amenities {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(100) // ชื่อสิ่งอำนวยความสะดวก
  created_at         DateTime             @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  property_amenities property_amenities[]
}

/// ตารางเชื่อมความสัมพันธ์ อสังหาริมทรัพย์ - สิ่งอำนวยความสะดวก (Many-to-Many)
model property_amenities {
  property_id String     @db.Uuid // รหัสอสังหาฯ
  amenity_id  Int        // รหัสสิ่งอำนวยความสะดวก
  amenities   amenities  @relation(fields: [amenity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([property_id, amenity_id])
}

/// ตารางมาสเตอร์สถานที่ใกล้เคียง (สถานีรถไฟฟ้า, ห้างสรรพสินค้า, โรงพยาบาล)
model nearby_places {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(150) // ชื่อสถานที่ใกล้เคียง
  type              String?             @db.VarChar(50) // ประเภทสถานที่ (BTS, Mall, Hospital)
  created_at        DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  property_nearbies property_nearbies[]
}

/// ตารางเชื่อมความสัมพันธ์ อสังหาริมทรัพย์ - สถานที่ใกล้เคียง (Many-to-Many)
model property_nearbies {
  property_id     String        @db.Uuid
  nearby_place_id Int
  distance_meters Decimal?      @db.Decimal(6, 1) // ระยะห่างจากบ้าน (เมตร)
  nearby_places   nearby_places @relation(fields: [nearby_place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties      properties    @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([property_id, nearby_place_id])
}

/// ตารางเก็บรายการอสังหาริมทรัพย์ที่ผู้ใช้กดถูกใจเป็น "รายการโปรด" (Favorites / Saved)
model saved_properties {
  user_id     String     @db.Uuid // รหัสผู้ใช้ที่กดถูกใจ
  property_id String     @db.Uuid // รหัสอสังหาฯ ที่ถูกใจ
  created_at  DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, property_id])
}


// ==============================================================================
// 3. ระบบทำเลที่ตั้งและจังหวัด (Locations Module)
// ==============================================================================

/// ตารางข้อมูลจังหวัด (77 จังหวัดทั่วประเทศไทย)
model provinces {
  id         Int          @id
  name_th    String       @db.VarChar(150) // ชื่อจังหวัดภาษาไทย
  name_en    String       @db.VarChar(150) // ชื่อจังหวัดภาษาอังกฤษ
  created_at DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  amphures   amphures[]
  properties properties[]
}

/// ตารางข้อมูลอำเภอ/เขต (ผูกกับจังหวัด)
model amphures {
  id          Int          @id
  name_th     String       @db.VarChar(150) // ชื่ออำเภอภาษาไทย
  name_en     String       @db.VarChar(150) // ชื่ออำเภอภาษาอังกฤษ
  province_id Int          // รหัสจังหวัดสังกัด
  created_at  DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  provinces   provinces    @relation(fields: [province_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  districts   districts[]
  properties  properties[]

  @@index([province_id], map: "idx_amphures_province")
}

/// ตารางข้อมูลตำบล/แขวง และรหัสไปรษณีย์ (ผูกกับอำเภอ)
model districts {
  id         Int          @id
  name_th    String       @db.VarChar(150) // ชื่อตำบลภาษาไทย
  name_en    String       @db.VarChar(150) // ชื่อตำบลภาษาอังกฤษ
  zip_code   Int          // รหัสไปรษณีย์
  amphure_id Int          // รหัสอำเภอสังกัด
  created_at DateTime     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  amphures   amphures     @relation(fields: [amphure_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties properties[]

  @@index([amphure_id], map: "idx_districts_amphure")
}


// ==============================================================================
// 4. ระบบการนัดหมายและรีวิว (Appointments & Reviews Module)
// ==============================================================================

/// ตารางรายการนัดหมายเข้าชมอสังหาริมทรัพย์ ระหว่าง ลูกค้า กับ นายหน้า
model appointments {
  id                                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสนัดหมาย
  customer_id                           String?     @db.Uuid // รหัสลูกค้าผู้จองนัด
  agent_id                              String?     @db.Uuid // รหัสนายหน้าผู้ดูแล
  property_id                           String?     @db.Uuid // รหัสอสังหาฯ ที่ต้องการเข้าชม
  appointment_date                      DateTime    @db.Date // วันที่นัดหมายเข้าชม
  time_slot                             String?     @db.VarChar(20) // รอบเวลานัดหมาย (เช่น "10:00 - 11:00")
  status                                String?     @default("pending") @db.VarChar(20) // สถานะนัดหมาย (pending, approved, rejected, completed, cancelled)
  note                                  String?     // ข้อความหมายเหตุเพิ่มเติมจากลูกค้า
  original_date                         DateTime?   @db.Date // วันที่ลูกค้าเลือกรอบแรก (ใช้แสดงขีดฆ่าถ้านายหน้าขอเลื่อนวัน)
  original_time_slot                    String?     @db.VarChar(20) // รอบเวลาที่ลูกค้าเลือกรอบแรก
  cancel_reason                         String?     @db.VarChar(255) // เหตุผลการยกเลิกนัดหมาย
  created_at                            DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users_appointments_agent_idTousers    users?      @relation("appointments_agent_idTousers", fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_appointments_customer_idTousers users?      @relation("appointments_customer_idTousers", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties                            properties? @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews                               reviews?

  @@index([agent_id], map: "idx_appointments_agent")
  @@index([customer_id], map: "idx_appointments_customer")
}

/// ตารางรีวิวและให้คะแนนการบริการของนายหน้าหลังจากพาลูกค้าชมบ้านเสร็จสิ้น
model reviews {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointment_id String?       @unique @db.Uuid // รหัสนัดหมายที่ถูกรีวิว
  rating         Int?          // คะแนนดาว (1 ถึง 5 ดาว)
  comment        String?       // ข้อความแสดงความคิดเห็นคำชม
  created_at     DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  appointments   appointments? @relation(fields: [appointment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}


// ==============================================================================
// 5. ระบบแชทและการสื่อสาร (Chat System Module)
// ==============================================================================

/// ตารางห้องแชทพูดคุยระหว่าง ลูกค้า กับ นายหน้า (ต่อ 1 อสังหาริมทรัพย์)
model chat_sessions {
  id                                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสห้องแชท
  customer_id                            String?     @db.Uuid // รหัสลูกค้า
  agent_id                               String?     @db.Uuid // รหัสนายหน้า
  property_id                            String?     @db.Uuid // รหัสอสังหาริมทรัพย์ที่สอบถาม
  created_at                             DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users_chat_sessions_agent_idTousers    users?      @relation("chat_sessions_agent_idTousers", fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_chat_sessions_customer_idTousers users?      @relation("chat_sessions_customer_idTousers", fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties                             properties? @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages                               messages[]

  @@unique([customer_id, agent_id, property_id])
}

/// ตารางกล่องข้อความย่อยภายในห้องแชท (Chat Messages)
model messages {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสข้อความ
  session_id    String?        @db.Uuid // รหัสห้องแชท (เชื่อมกับ chat_sessions)
  sender_id     String?        @db.Uuid // รหัสผู้ส่งข้อความ
  content       String?        // ข้อความแชท
  file_url      String?        @db.VarChar(255) // URL ไฟล์เอกสารหรือรูปภาพแนบ
  latitude      Decimal?       @db.Decimal(10, 8) // ละติจูดแชร์โลเคชัน
  longitude     Decimal?       @db.Decimal(11, 8) // ลองจิจูดแชร์โลเคชัน
  created_at    DateTime       @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users         users?         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chat_sessions chat_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id], map: "idx_messages_session")
}

/// ตารางเทมเพลตข้อความตอบกลับด่วนของนายหน้า (Quick Reply Templates)
model quick_reply_templates {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_id   String?  @db.Uuid // นายหน้าเจ้าของเทมเพลต
  title      String   @db.VarChar(100) // ชื่อหัวข้อเทมเพลต
  content    String   // ข้อความตอบกลับสำเร็จรูป
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users      users?   @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}


// ==============================================================================
// 6. ระบบแพ็กเกจและการชำระเงิน (Payments & Sales Module)
// ==============================================================================

/// ตารางมาสเตอร์แพ็กเกจการลงประกาศ (Basic, Pro, VIP)
model listing_packages {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique @db.VarChar(50) // ชื่อแพ็กเกจ
  price                  Decimal                  @db.Decimal(10, 2) // ราคาแพ็กเกจ (บาท)
  max_duration_days      Int                      // อายุจำนวนวันที่ลงประกาศได้
  created_at             DateTime                 @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  listing_package_orders listing_package_orders[]
}

/// ตารางรายการคำสั่งซื้อแพ็กเกจลงประกาศของนายหน้า
model listing_package_orders {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id          String?                @db.Uuid // รหัสอสังหาฯ ที่ใช้แพ็กเกจ
  package_id           Int?                   // รหัสแพ็กเกจที่ซื้อ
  start_date           DateTime               @db.Date // วันเริ่มใช้งาน
  end_date             DateTime               @db.Date // วันหมดอายุ
  status               String?                @default("pending") @db.VarChar(20) // สถานะคำสั่งซื้อ (pending, paid, expired)
  created_at           DateTime               @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  listing_packages     listing_packages?      @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties           properties?            @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_transactions payment_transactions[]
}

/// ตารางบันทึกการชำระเงินและสลิปหลักฐานการโอนเงิน
model payment_transactions {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id               String?                 @db.Uuid // รหัสคำสั่งซื้อที่อ้างอิง
  amount                 Decimal                 @db.Decimal(10, 2) // จำนวนเงินที่ชำระ
  payment_method         String?                 @db.VarChar(50) // ช่องทางชำระเงิน (PromptPay, Bank Transfer)
  slip_url               String?                 @db.VarChar(255) // URL หลักฐานสลิปการโอนเงิน
  status                 String?                 @default("pending") @db.VarChar(20) // สถานะตรวจสอบสลิป (pending, approved, rejected)
  created_at             DateTime                @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  listing_package_orders listing_package_orders? @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// ตารางประวัติการปิดการขายบ้านและคำนวณค่าคอมมิชชั่น
model sale_transactions {
  id                                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id                             String?     @db.Uuid // รหัสอสังหาริมทรัพย์ที่ปิดการขายได้
  agent_id                                String?     @db.Uuid // รหัสนายหน้าที่ขายได้
  buyer_id                                String?     @db.Uuid // รหัสผู้ซื้อ
  final_price                             Decimal     @db.Decimal(12, 2) // ราคาขายจริงที่ปิดได้
  commission_rate                         Decimal     @db.Decimal(4, 2) // อัตราค่าคอมมิชชั่น (%)
  commission_amount                       Decimal     @db.Decimal(10, 2) // ยอดเงินค่าคอมมิชชั่นสุทธิ
  transaction_date                        DateTime    @db.Date // วันที่ปิดการขายสำเร็จ
  agreement_file_url                      String?     @db.VarChar(255) // URL ไฟล์สัญญาซื้อขาย
  created_at                              DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users_sale_transactions_agent_idTousers users?      @relation("sale_transactions_agent_idTousers", fields: [agent_id], references: [id], onUpdate: NoAction)
  users_sale_transactions_buyer_idTousers users?      @relation("sale_transactions_buyer_idTousers", fields: [buyer_id], references: [id], onUpdate: NoAction)
  properties                              properties? @relation(fields: [property_id], references: [id], onUpdate: NoAction)
}


// ==============================================================================
// 7. รายงาน การแจ้งเตือน และโฆษณา (Reports & Ads Module)
// ==============================================================================

/// ตารางการแจ้งเตือนในระบบของผู้ใช้งาน (Notifications Center)
model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid // รหัสผู้รับการแจ้งเตือน
  title      String   @db.VarChar(150) // หัวข้อการแจ้งเตือน
  content    String   // ข้อความรายละเอียด
  is_read    Boolean? @default(false) // สถานะอ่านแล้วหรือยัง (true/false)
  type       String?  @db.VarChar(50) // ประเภทการแจ้งเตือน (appointment, chat, review)
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifications_user_unread", where: raw("(is_read = false)"))
}

/// ตารางการรายงานความผิดปกติ/ร้องเรียน (Report ประกาศ หรือ นายหน้า)
model reports {
  id                                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id                            String?     @db.Uuid // รหัสผู้แจ้งเรื่องร้องเรียน
  reported_property_id                   String?     @db.Uuid // รหัสอสังหาฯ ที่ถูกร้องเรียน (ถ้ามี)
  reported_agent_id                      String?     @db.Uuid // รหัสนายหน้าที่ถูกร้องเรียน (ถ้ามี)
  reason                                 String      @db.VarChar(150) // สาเหตุที่ร้องเรียน
  details                                String?     // รายละเอียดคำร้องเรียน
  status                                 String?     @default("pending") @db.VarChar(20) // สถานะเรื่องร้องเรียน (pending, resolved, dismissed)
  created_at                             DateTime    @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  users_reports_reported_agent_idTousers users?      @relation("reports_reported_agent_idTousers", fields: [reported_agent_id], references: [id], onUpdate: NoAction)
  properties                             properties? @relation(fields: [reported_property_id], references: [id], onUpdate: NoAction)
  users_reports_reporter_idTousers       users?      @relation("reports_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// ตารางแคมเปญโฆษณาและแบนเนอร์โปรโมตหน้าเว็บ
model banner_campaigns {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String   @db.VarChar(100) // ชื่อแคมเปญโฆษณา
  image_url  String   @db.VarChar(255) // URL รูปภาพแบนเนอร์
  link_url   String?  @db.VarChar(255) // ลิงก์เมื่อผู้ใช้กดแบนเนอร์
  start_date DateTime @db.Date // วันเริ่มแสดงผล
  end_date   DateTime @db.Date // วันสิ้นสุดแสดงผล
  status     String?  @default("inactive") @db.VarChar(20) // สถานะแคมเปญ (active/inactive)
  created_at DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// ตารางโปรโมชันและโค้ดส่วนลดค่าบริการ
model promotions {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(100) // ชื่อโปรโมชัน
  discount_rate Decimal? @db.Decimal(4, 2) // อัตราส่วนลด (%)
  start_date    DateTime @db.Date // วันเริ่มโปรโมชัน
  end_date      DateTime @db.Date // วันหมดอายุโปรโมชัน
  code          String?  @unique @db.VarChar(20) // โค้ดส่วนลด (เช่น SAVE10)
  created_at    DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}


// ==============================================================================
// 8. การตั้งค่าระบบสล็อตวันเวลาดูบ้าน (System Configs & Slots Module)
// ==============================================================================

/// ตารางเก็บค่าการตั้งค่าทั่วไปของระบบ (Key-Value Configs)
model system_configs {
  key         String   @id @db.VarChar(50) // ชื่อคีย์การตั้งค่า
  value       String   @db.VarChar(255) // ค่าของการตั้งค่า
  description String?  // คำอธิบายรายละเอียดการตั้งค่า
  updated_at  DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// ตารางวันเวลาที่นายหน้าเปิดให้จองเข้าชม "บ้านหลังนี้" โดยเฉพาะ (ผูกกับบ้านรายหลัง)
model property_viewing_slots {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // รหัสสล็อตวันว่าง
  property_id    String     @db.Uuid // รหัสอสังหาริมทรัพย์
  available_date DateTime   @db.Date // วันที่เปิดรับจอง
  time_slot      String     @db.VarChar(20) // ช่วงเวลาที่เปิดรับจอง (เช่น "09:00 - 10:00")
  is_booked      Boolean    @default(false) // สถานะถูกจองไปแล้วหรือยัง (true = จองแล้ว, false = ว่าง)
  created_at     DateTime   @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  properties     properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([property_id, available_date, time_slot])
  @@index([property_id], map: "idx_property_viewing_slots_property")
}
