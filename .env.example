# 🔑 URL สำหรับเชื่อมต่อฐานข้อมูล PostgreSQL (แนะนำให้แต่ละคนติดตั้ง PostgreSQL ในเครื่องตัวเอง หรือใช้คลาวด์ร่วมกัน)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/srichai_db?schema=public"

# 🔑 รหัสลับสำหรับระบบความปลอดภัย NextAuth.js (สามารถเปลี่ยนคีย์ลับนี้เป็นคำหรือข้อความสุ่มอื่นได้)
NEXTAUTH_SECRET="your-super-secret-key-at-least-32-characters"

# 🌐 URL ของเว็บหน้าบ้าน Next.js (สำหรับรันบนเครื่องตัวเองใช้ localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# 🔑 ตั้งค่าสำหรับการล็อกอินด้วย Google (ถ้าต้องการใช้งาน)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 📅 API Key สำหรับดึงข้อมูลวันหยุดไทยจาก Google Calendar (จำเป็น — ระบบวันหยุดใช้ Google Calendar API เป็นหลัก ไม่มี fallback)
# วิธีขอ Key: https://console.cloud.google.com/apis/credentials → Create Credentials → API Key
# แล้วเปิดใช้งาน Google Calendar API ที่: https://console.cloud.google.com/apis/library/calendar-googleapis-com
# ⚠️ อย่าใส่ Key จริงในไฟล์นี้ (เป็นไฟล์ตัวอย่าง) ให้ใส่ใน .env.local แทน
GOOGLE_CALENDAR_API_KEY="your-google-calendar-api-key"

# 🔑 ตั้งค่าสำหรับการล็อกอินด้วย Facebook (ถ้าต้องการใช้งาน)
FACEBOOK_CLIENT_ID="your-facebook-client-id"
FACEBOOK_CLIENT_SECRET="your-facebook-client-secret"

# 🔌 ตั้งค่าสำหรับระบบแชทเรียลไทม์ผ่าน Pusher Channels (สมัครฟรีที่ https://dashboard.pusher.com)
# NEXT_PUBLIC_* สองตัวใช้ฝั่ง browser ได้ ส่วน PUSHER_APP_ID / PUSHER_SECRET ใช้ฝั่ง server เท่านั้น ห้ามเปิดเผย
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"

# 📧 ตั้งค่าระบบส่งอีเมลแจ้งเตือนอัตโนมัติ (Email Notifications ผ่าน Gmail SMTP)
# วิธีขอ App Password: https://myaccount.google.com/apppasswords (ตั้งชื่อแอปแล้วรับรหัสผ่าน 16 ตัว)
# หากไม่ใส่ค่าเหล่านี้ ระบบจะทำงานในโหมด Dev/Mock Mode ปลอดภัยโดยไม่ทำให้เว็บ Error
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Srichai Property <your-email@gmail.com>"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
